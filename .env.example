# Solo configuración pública del cliente; estos valores son ficticios.
VITE_FIREBASE_API_KEY=demo-public-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-finanzas.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-finanzas
VITE_FIREBASE_STORAGE_BUCKET=demo-finanzas.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_FIREBASE_VAPID_KEY=demo-public-vapid-key
VITE_USE_FIREBASE_EMULATORS=true
VITE_AI_API_URL=http://localhost:8787
# Worker variables públicas se configuran en wrangler.toml según entorno.
# Nunca usar VITE_ para secretos. Configurar fuera del repositorio mediante:
# wrangler secret put GROQ_API_KEY (Worker ai)
# wrangler secret put FCM_SERVICE_ACCOUNT_JSON (Worker reminders)
# No hay allowlist de un propietario: el aislamiento se deriva del UID autenticado.
