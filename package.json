{
  "name": "finanzas-personales",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/contracts",
    "packages/domain",
    "packages/testkit",
    "workers/ai",
    "workers/reminders"
  ],
  "engines": {
    "node": "24.14.1",
    "npm": "11.11.0"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "npm run dev --workspace @fin/web",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --project demo-finanzas-tests --config firebase.rules-test.json --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "firebase emulators:exec --project demo-finanzas-tests --config firebase.rules-test.json --only auth,firestore \"playwright test\"",
    "emulators": "firebase emulators:start --project demo-finanzas-tests --config firebase.rules-test.json --only auth,firestore",
    "build": "npm run build --workspaces",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "firebase-tools": "15.34.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
